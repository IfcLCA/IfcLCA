# Postgres. Neon in production: use the pooled connection string.
DATABASE_URL=postgresql://postgres@localhost:5432/ifclca
# Optional: an empty database for the repository tests. They truncate it.
TEST_DATABASE_URL=

# Clerk. Leave empty in development to use Clerk keyless mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# KBOB data from lcadata.ch
KBOB_API_KEY=
KBOB_API_URL=https://www.lcadata.ch
# Vercel Cron sends this as a bearer token to /api/kbob/sync
CRON_SECRET=

# Project images (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Optional
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
GITHUB_TOKEN=
